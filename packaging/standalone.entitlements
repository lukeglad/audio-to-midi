<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The standalone records from the input device. Under the hardened
         runtime (required for notarization) the microphone is denied
         without this, silently: recording would capture nothing. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
